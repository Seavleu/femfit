# =====================================================
# FemFit Environment Variables
# Copy this file to .env.local and fill in values
# =====================================================

# --- Database ---
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_DIRECT_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://[project].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- ABA PayWay ---
ABA_MERCHANT_ID=
ABA_API_KEY=
ABA_WEBHOOK_SECRET=
ABA_PAYWAY_URL=https://sandbox.payway.com.kh
# Production: https://payway.com.kh

# --- SMS (Twilio at launch) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+855xxxxxxxxx

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@femfit.com

# --- Monitoring ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Protect Vercel cron + admin job routes
CRON_SECRET=
NODE_ENV=development
# Show / use hardcoded dev1 (customer) + dev2 (admin) on /sign-in
# NEXT_PUBLIC_ENABLE_DEV_LOGIN=true
# FORCE_SEED_DEV_ACCOUNTS=true

# --- Feature flags (optional) ---
ENABLE_COD=true
ENABLE_KHQR=true
# ABA PayWay UI deferred — enable when sandbox integration is next
ENABLE_ABA_PAYWAY=false
